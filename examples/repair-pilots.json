        {
          "name": "Reviewed fix",
          "source": "exports.latestTicketStates = function latestTicketStates(events) {\n  const map = new Map();\n  for (const row of events) {\n    if (!row || typeof row.id !== 'string' || !row.id || !['open', 'closed'].includes(row.state) || typeof row.atMs !== 'number' || !Number.isSafeInteger(row.atMs) || row.atMs < 0) continue;\n    const existing = map.get(row.id);\n    if (!existing) {\n      map.set(row.id, { state: row.state, atMs: row.atMs });\n    } else {\n      if (row.atMs > existing.atMs) {\n        existing.atMs = row.atMs;\n        existing.state = row.state;\n      }\n    }\n  }\n  return Array.from(map.entries()).map(([id, data]) => [id, data.state]);\n};",
