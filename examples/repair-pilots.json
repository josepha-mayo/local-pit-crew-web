          "name": "Gemini draft",
          "source": "exports.uniqueContactLabels = function(labels) { const result = []; const seen = new Set(); for (const item of labels) { if (typeof item !== 'string') continue; const cleaned = item.trim().replace(/\\s+/g, ' ').normalize('NFC'); if (!cleaned) continue; const key = cleaned.toLowerCase().normalize('NFC'); if (!seen.has(key)) { seen.add(key); result.push(cleaned); } } return result; };",
