          "name": "Original",
          "source": "exports.latestTicketStates = function latestTicketStates(events) {\n  const latest = {};\n  for (const row of events.sort((a, b) => a.atMs - b.atMs)) {\n    if (!row || typeof row.id !== 'string' || !row.id || !['open', 'closed'].includes(row.state)) continue;\n    latest[row.id] = row;\n  }\n  return Object.values(latest).map(row => [row.id, row.state]);\n};",
